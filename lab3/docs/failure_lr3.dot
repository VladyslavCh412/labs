digraph G {graph [fontname="DejaVu Sans",label="Експеримент з відмовою Fleet",labelloc=t,fontsize=16,bgcolor=white,ranksep=.7];node[fontname="DejaVu Sans",shape=box,style="rounded,filled",color="#576075",fontsize=12];client[label="Клієнт\nPOST /trips",fillcolor="#ECEFF4"];trips[label="Trips\nсинхронна перевірка",fillcolor="#DFF0FF"];fleet[label="Fleet\nOFF",fillcolor="#FFE1E1"];reject[label="HTTP 503\nрейс НЕ створено",fillcolor="#FFE1E1"];outbox[label="Раніше збережений\nTripCreated у outbox",fillcolor="#FFF1DA"];worker[label="Worker\nдоставляє повідомлення",fillcolor="#DFF4E9"];client->trips;trips->fleet [label="GET -> connection refused",style=dashed];trips->reject[label="fail-closed"];outbox->worker[label="незалежно від Fleet",style=dashed];}
