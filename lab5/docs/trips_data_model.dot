digraph G {rankdir=LR; graph [bgcolor="white",pad="0.15",nodesep="0.4",ranksep="0.7"]; node [shape=record,fontname="DejaVu Sans",fontsize=11,style=filled,fillcolor="#EAF3FA",color="#47627F"];edge[color="#65849A",arrowsize=.7];trip[label="{Trips: trips|id (PK)\nvehicle_id\ndriver_id\nroute_id\nstatus}"];routes[label="{Trips: routes|id (PK)\nstops_json}"];out[label="{Trips: outbox|event_id (PK)\ntype\npayload(JSON)\ndelivered}",fillcolor="#FFF0DF"];notify[label="{notification_inbox|event_id (PK)\ntrip_id\nmessage}"];read[label="{vehicle_snapshot (read-only)|id (PK)\nplate\nstatus\nversion\nupdated_at}",fillcolor="#EDF7F1"]; inbox[label="{fleet_event_inbox|event_id (PK)\nreceived_at}",fillcolor="#EDF7F1"];trip->routes[label="route_id"];trip->out[label="TripCreated",style=dashed];out->notify[style=dashed];inbox->read[label="VehicleStatusChanged",style=dashed];}
