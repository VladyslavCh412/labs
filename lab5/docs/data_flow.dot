digraph G {rankdir=LR;graph[bgcolor="white",pad="0.2",ranksep="0.8"];node[shape=box,style="rounded,filled",fillcolor="#EAF3FA",fontname="DejaVu Sans",fontsize=12,penwidth=1.1,color="#47627F",margin="0.14,0.1"];fleet[label="Fleet API\ncache TTL=30s\nSQLite fleet.sqlite"];bridge[label="HTTP bridge\nretry + ACK after delivery",fillcolor="#FFF0DF"];trips[label="Trips API\nvehicle_snapshot\nSQLite trips.sqlite",fillcolor="#EDF7F1"];fleet -> bridge[label="outbox JSON event"];bridge -> trips[label="POST /events/fleet-status"];bridge -> fleet [label="ACK event",constraint=false,color="#7A929B"];}
