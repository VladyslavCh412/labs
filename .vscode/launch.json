{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "FleetFlow: запустити проєкт",
      "type": "debugpy",
      "request": "launch",
      "python": "${workspaceFolder}/lab8final/.venv/Scripts/python.exe",
      "program": "${workspaceFolder}/run.py",
      "args": [
        "start"
      ],
      "cwd": "${workspaceFolder}",
      "console": "internalConsole",
      "internalConsoleOptions": "openOnSessionStart",
      "subProcess": true,
      "justMyCode": true,
      "env": {
        "PYDEVD_DISABLE_FILE_VALIDATION": "1"
      }
    }
  ]
}
