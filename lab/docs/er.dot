digraph G {rankdir=LR;graph[bgcolor=white]; node [shape=record fontname="DejaVu Sans" fontsize=11]; vehicle[label="{Fleet DB|ТЗ: id, plate, mileage_km, status, plate_normalized|ТО: id, vehicle_id, planned_at}" fillcolor="#ebf5fa" style=filled]; trips[label="{Trips DB|Рейс: id, vehicle_id, driver_id, route_id, status|Маршрут: id, stops|vehicle_projection: id, plate, status, version}" fillcolor="#fbf1da" style=filled];ev[label="Подія VehicleUpdated\n{id, plate, status, version}" shape=box style="rounded,filled" fillcolor="#e5f5e5"];vehicle->ev[label="outbox"];ev->trips[label="inbox + upsert, only newer versions"]; }