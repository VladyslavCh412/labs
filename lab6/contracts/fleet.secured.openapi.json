  "components": {
    "schemas": {
      "DriverCreateBody": {
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "title": "Id"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "title": "Name"
          },
          "active": {
            "type": "boolean",
            "title": "Active",
            "default": true
          },
          "license_valid": {
            "type": "boolean",
            "title": "License Valid",
            "default": true
          }
        },
        "type": "object",
        "required": [
          "id",
          "name"
        ],
        "title": "DriverCreateBody"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "RegistrationBody": {
        "properties": {
          "plate": {
            "type": "string",
            "title": "Plate"
          }
        },
        "type": "object",
        "required": [
          "plate"
        ],
        "title": "RegistrationBody"
      },
      "StatusBody": {
        "properties": {
          "status": {
            "$ref": "#/components/schemas/VehicleStatus"
          }
        },
        "type": "object",
        "required": [
          "status"
        ],
        "title": "StatusBody"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      },
      "VehicleCreateBody": {
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "title": "Id"
          },
          "plate": {
            "type": "string",
            "minLength": 1,
            "title": "Plate"
          },
          "status": {
            "$ref": "#/components/schemas/VehicleStatus",
            "default": "available"
          }
        },
        "type": "object",
        "required": [
          "id",
          "plate"
        ],
        "title": "VehicleCreateBody"
      },
      "VehicleStatus": {
        "type": "string",
        "enum": [
          "available",
          "in_trip",
          "maintenance"
        ],
        "title": "VehicleStatus"
      }
    },
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  }
